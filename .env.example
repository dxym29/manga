# Example: postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/manga_translator
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/manga_translator

# Gemini API key. Leave blank to use manual translation editing only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL import stays disabled when this is blank.
# Comma-separated exact hostnames that you are authorized to access, e.g. your-own-site.example,cdn.your-own-site.example
ALLOWED_SOURCE_DOMAINS=

# Optional full path to tesseract.exe on Windows.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
