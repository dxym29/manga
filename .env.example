# Local PostgreSQL; encode password characters (# -> %23, @ -> %40)
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/manga_translator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional exact authorized HTTPS hostnames, comma-separated. Blank disables URL import.
ALLOWED_SOURCE_DOMAINS=
PGSSL=false
PORT=3000
